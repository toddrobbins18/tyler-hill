<tr><th>Method</th><th>Endpoint</th><th>Description</th></tr>
<tr><td><span class="badge get">GET</span></td><td><code>/rest/v1/division_schedules?select=*&company_id=eq.{id}&division_id=eq.{div_id}</code></td><td>Get uploaded schedules</td></tr>
