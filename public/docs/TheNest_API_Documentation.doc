<tr><th>Bucket Name</th><th>Public?</th><th>Used For</th></tr>
<tr><td><code>profile-photos</code></td><td>No (signed URLs)</td><td>Camper &amp; staff profile photos</td></tr>
<tr><td><code>company-logos</code></td><td>Yes</td><td>Company logo images</td></tr>
<tr><td><code>daily-wolf-documents</code></td><td>Yes</td><td>Daily Wolf PDF/document uploads</td></tr>
<tr><td><code>rainy-day-documents</code></td><td>Yes</td><td>Rainy day schedules &amp; special event files</td></tr>
<tr><td><code>trip-attachments</code></td><td>Yes</td><td>Trip/transportation file attachments</td></tr>
<tr><td><code>division-schedules</code></td><td>No (signed URLs)</td><td>Division schedule documents</td></tr>
</table>

<h3>Storage Operations</h3>
<table>
<tr><th>Operation</th><th>Method</th><th>Endpoint</th><th>Notes</th></tr>
<tr><td>Upload File</td><td><span class="badge post">POST</span></td><td><code>/storage/v1/object/{bucket}/{path}</code></td><td>Body: file binary. Headers: <code>Content-Type: {mime}</code></td></tr>
<tr><td>Get Public URL</td><td><span class="badge get">GET</span></td><td><code>/storage/v1/object/public/{bucket}/{path}</code></td><td>Only for public buckets</td></tr>
<tr><td>Create Signed URL</td><td><span class="badge post">POST</span></td><td><code>/storage/v1/object/sign/{bucket}/{path}</code></td><td>Body: <code>{ "expiresIn": 3600 }</code></td></tr>
<tr><td>Delete File</td><td><span class="badge delete">DELETE</span></td><td><code>/storage/v1/object/{bucket}/{path}</code></td><td></td></tr>
<tr><td>List Files</td><td><span class="badge post">POST</span></td><td><code>/storage/v1/object/list/{bucket}</code></td><td>Body: <code>{ "prefix": "folder/" }</code></td></tr>
</table>

